{
  "name": "vitra",
  "productName": "Vitra",
  "version": "0.1.0",
  "description": "El Diario de Fran: notas en Markdown enlazadas con [[ ]], con backlinks y grafo, en una ventana de vidrio acrílico.",
  "main": "main.cjs",
  "author": "Kidd Shady · Umbrovex Systems <umbrovex@proton.me>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/tokens.test.mjs && node test/store.test.mjs && node test/format.test.mjs && node test/diario.test.mjs && node test/actualizador.test.mjs",
    "smoke": "electron test/smoke.test.cjs",
    "icon": "electron tools/icono.cjs",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "3.2.1"
  },
  "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
  "homepage": "https://github.com/kiddshady/Vitra",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiddshady/Vitra.git"
  },
  "build": {
    "appId": "com.umbrovex.vitra",
    "productName": "Vitra",
    "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "Vitra",
      "releaseType": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "LICENSE",
      "NOTICE",
      "package.json",
      "!data/**",
      "!test/**",
      "!docs/**",
      "!tools/**",
      "!mcp/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
